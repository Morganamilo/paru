#: src/help.rs:4
msgid "Usage:"
msgstr "Użycie:"

#: src/help.rs:5
msgid "    paru"
msgstr "    paru"

#: src/help.rs:6
msgid "    paru <operation> [...]"
msgstr "    paru <operacja> [...]"

#: src/help.rs:7
msgid "    paru <package(s)>"
msgstr "    paru <pakiet(y)>"

#: src/help.rs:9
msgid "Pacman operations:"
msgstr "Operacje pacmana:"

#: src/help.rs:10
msgid "    paru {-h --help}"
msgstr "    paru {-h --help}"

#: src/help.rs:11
msgid "    paru {-V --version}"
msgstr "    paru {-V --version}"

#: src/help.rs:12
msgid "    paru {-D --database}    <options> <package(s)>"
msgstr "    paru {-D --database}    <opcje> <pakiet(y)>"

#: src/help.rs:13
msgid "    paru {-F --files}       [options] [package(s)]"
msgstr "    paru {-F --files}       [opcje] [pakiet(y)]"

#: src/help.rs:14
msgid "    paru {-Q --query}       [options] [package(s)]"
msgstr "    paru {-Q --query}       [opcje] [pakiet(y)]"

#: src/help.rs:15
msgid "    paru {-R --remove}      [options] <package(s)>"
msgstr "    paru {-R --remove}      [opcje] <pakiet(y)>"

#: src/help.rs:16
msgid "    paru {-S --sync}        [options] [package(s)]"
msgstr "    paru {-S --sync}        [opcje] [pakiet(y)]"

#: src/help.rs:17
msgid "    paru {-T --deptest}     [options] [package(s)]"
msgstr "    paru {-T --deptest}     [opcje] [pakiet(y)]"

#: src/help.rs:18
msgid "    paru {-U --upgrade}     [options] [file(s)]"
msgstr "    paru {-U --upgrade}     [opcje] [plik(i)]"

#: src/help.rs:20
msgid "New operations:"
msgstr "Nowe operacje:"

#: src/help.rs:21
msgid "    paru {-P --show}        [options]"
msgstr "    paru {-P --show}        [opcje]"

#: src/help.rs:22
msgid "    paru {-G --getpkgbuild} [package(s)]"
msgstr "    paru {-G --getpkgbuild} [pakiet(y)]"

#: src/help.rs:23
msgid "    paru {-B --build}       [dir(s)]"
msgstr "    paru {-B --build}       [katalog(i)]"

#: src/help.rs:25
msgid "If no arguments are provided 'paru -Syu' will be performed"
msgstr "Jeśli nie podano argumentów, zostanie wykonane 'paru -Syu'"

#: src/help.rs:27
msgid "Options without operation:"
msgstr "Opcje bez operacji:"

#: src/help.rs:28
msgid "    -c --clean            Remove unneeded dependencies"
msgstr "    -c --clean            Usuń niepotrzebne zależności"

#: src/help.rs:29
msgid ""
"       --gendb            Generates development package DB used for updating"
msgstr ""
"       --gendb            Generuje bazę pakietów devel używaną przy "
"aktualizacji"

#: src/help.rs:31
msgid "New options:"
msgstr "Nowe opcje:"

#: src/help.rs:32
msgid "       --repo              Assume targets are from the repositories"
msgstr "       --repo              Zakładaj, że cele pochodzą z repozytoriów"

#: src/help.rs:33
msgid ""
"       --pkgbuilds         Assume targets are from pkgbuild repositories"
msgstr ""
"       --pkgbuilds         Zakładaj, że cele pochodzą z repozytoriów PKGBUILD"

#: src/help.rs:34
msgid "    -a --aur               Assume targets are from the AUR"
msgstr "    -a --aur               Zakładaj, że cele pochodzą z AUR"

#: src/help.rs:35
msgid "    --mode      <mode>     Sets where paru looks for targets"
msgstr "    --mode      <mode>     Określa, gdzie paru szuka celów"

#: src/help.rs:37
msgid ""
"    --interactive          Enable interactive package selection for -S, -R, -"
"Ss and -Qs"
msgstr ""
"    --interactive          Włącz interaktywny wybór pakietów dla -S, -R, -Ss "
"i -Qs"

#: src/help.rs:39
msgid "    --aururl    <url>      Set an alternative AUR URL"
msgstr "    --aururl    <url>      Ustaw alternatywny adres URL AUR"

#: src/help.rs:40
msgid ""
"    --aurrpcur  <url>      Set an alternative URL for the AUR /rpc endpoint"
msgstr "    --aurrpcur  <url>      Ustaw alternatywny adres URL dla /rpc w AUR"

#: src/help.rs:41
msgid "    --clonedir  <dir>      Directory used to download and run PKGBUILDs"
msgstr ""
"    --clonedir  <dir>      Katalog do pobierania i uruchamiania plików "
"PKGBUILD"

#: src/help.rs:43
msgid "    --makepkg   <file>     makepkg command to use"
msgstr "    --makepkg   <file>     Polecenie makepkg do użycia"

#: src/help.rs:44
msgid "    --mflags    <flags>    Pass arguments to makepkg"
msgstr "    --mflags    <flags>    Przekaż argumenty do makepkg"

#: src/help.rs:45
msgid "    --pacman    <file>     pacman command to use"
msgstr "    --pacman    <file>     Polecenie pacman do użycia"

#: src/help.rs:46
msgid "    --git       <file>     git command to use"
msgstr "    --git       <file>     Polecenie git do użycia"

#: src/help.rs:47
msgid "    --gitflags  <flags>    Pass arguments to git"
msgstr "    --gitflags  <flags>    Przekaż argumenty do git"

#: src/help.rs:48
msgid "    --sudo      <file>     sudo command to use"
msgstr "    --sudo      <file>     Polecenie sudo do użycia"

#: src/help.rs:49
msgid "    --sudoflags <flags>    Pass arguments to sudo"
msgstr "    --sudoflags <flags>    Przekaż argumenty do sudo"

#: src/help.rs:50
msgid "    --pkgctl    <file>     pkgctl command to use"
msgstr "    --pkgctl    <file>     Polecenie pkgctl do użycia"

#: src/help.rs:51
msgid "    --bat       <file>     bat command to use"
msgstr "    --bat       <file>     Polecenie bat do użycia"

#: src/help.rs:52
msgid "    --batflags  <flags>    Pass arguments to bat"
msgstr "    --batflags  <flags>    Przekaż argumenty do bat"

#: src/help.rs:53
msgid "    --gpg       <file>     gpg command to use"
msgstr "    --gpg       <file>     Polecenie gpg do użycia"

#: src/help.rs:54
msgid "    --gpgflags  <flags>    Pass arguments to gpg"
msgstr "    --gpgflags  <flags>    Przekaż argumenty do gpg"

#: src/help.rs:55
msgid "    --fm        <file>     File manager to use for PKGBUILD review"
msgstr "    --fm        <file>     Menedżer plików do przeglądania PKGBUILD"

#: src/help.rs:56
msgid "    --fmflags   <flags>    Pass arguments to file manager"
msgstr "    --fmflags   <flags>    Przekaż argumenty do menedżera plików"

#: src/help.rs:58
msgid "    --completioninterval   <n> Time in days to refresh completion cache"
msgstr ""
"    --completioninterval   <n> Co ile dni odświeżać pamięć podręczną "
"uzupełniania"

#: src/help.rs:59
msgid ""
"    --sortby    <field>    Sort AUR results by a specific field during search"
msgstr ""
"    --sortby    <field>    Sortuj wyniki wyszukiwania w AUR według podanego "
"pola"

#: src/help.rs:60
msgid "    --searchby  <field>    Search for packages using a specified field"
msgstr "    --searchby  <field>    Szukaj pakietów według podanego pola"

#: src/help.rs:61
msgid ""
"    --limit     <limit>    Limits the number of items returned in a search"
msgstr "    --limit     <limit>    Ogranicza liczbę wyników wyszukiwania"

#: src/help.rs:62
msgid "    -x --regex             Enable regex for aur search"
msgstr ""
"    -x --regex             Włącz wyrażenia regularne przy wyszukiwaniu w AUR"

#: src/help.rs:64
msgid "    --skipreview           Skip the review process"
msgstr "    --skipreview           Pomiń przegląd"

#: src/help.rs:65
msgid "    --review               Don't skip the review process"
msgstr "    --review               Nie pomijaj przeglądu"

#: src/help.rs:66
msgid "    --[no]upgrademenu      Show interactive menu to skip upgrades"
msgstr ""
"    --[no]upgrademenu      Pokaż interaktywne menu pomijania aktualizacji"

#: src/help.rs:67
msgid "    --[no]removemake       Remove makedepends after install"
msgstr "    --[no]removemake       Usuń zależności budowania po instalacji"

#: src/help.rs:68
msgid "    --[no]cleanafter       Remove package sources after install"
msgstr "    --[no]cleanafter       Usuń źródła pakietów po instalacji"

#: src/help.rs:69
msgid "    --[no]rebuild          Always build target packages"
msgstr "    --[no]rebuild          Zawsze buduj pakiety docelowe"

#: src/help.rs:70
msgid "    --[no]redownload       Always download PKGBUILDs of targets"
msgstr "    --[no]redownload       Zawsze pobieraj pliki PKGBUILD celów"

#: src/help.rs:72
msgid "    --[no]pgpfetch         Prompt to import PGP keys from PKGBUILDs"
msgstr "    --[no]pgpfetch         Pytaj o import kluczy PGP z plików PKGBUILD"

#: src/help.rs:73
msgid ""
"    --[no]useask           Automatically resolve conflicts using pacman's "
"ask flag"
msgstr ""
"    --[no]useask           Rozwiązuj konflikty automatycznie flagą ask "
"pacmana"

#: src/help.rs:74
msgid ""
"    --[no]savechanges      Commit changes to pkgbuilds made during review"
msgstr ""
"    --[no]savechanges      Zatwierdzaj zmiany w PKGBUILD wprowadzone podczas "
"przeglądu"

#: src/help.rs:75
msgid "    --[no]newsonupgrade    Print new news during sysupgrade"
msgstr ""
"    --[no]newsonupgrade    Pokazuj nowe aktualności podczas aktualizacji "
"systemu"

#: src/help.rs:76
msgid ""
"    --[no]combinedupgrade  Refresh then perform the repo and AUR upgrade "
"together"
msgstr ""
"    --[no]combinedupgrade  Odśwież, a potem aktualizuj repozytoria i AUR "
"razem"

#: src/help.rs:77
msgid ""
"    --[no]batchinstall     Build multiple AUR packages then install them "
"together"
msgstr ""
"    --[no]batchinstall     Zbuduj kilka pakietów z AUR, a potem zainstaluj "
"je razem"

#: src/help.rs:78
msgid ""
"    --[no]provides         Look for matching providers when searching for "
"packages"
msgstr ""
"    --[no]provides         Szukaj pasujących dostawców przy wyszukiwaniu "
"pakietów"

#: src/help.rs:79
msgid "    --[no]devel            Check development packages during sysupgrade"
msgstr ""
"    --[no]devel            Sprawdzaj pakiety devel podczas aktualizacji "
"systemu"

#: src/help.rs:80
msgid ""
"    --[no]installdebug     Also install debug packages when a package "
"provides them"
msgstr ""
"    --[no]installdebug     Instaluj też pakiety debug, jeśli pakiet je "
"udostępnia"

#: src/help.rs:81
msgid ""
"    --[no]sudoloop         Loop sudo calls in the background to avoid timeout"
msgstr ""
"    --[no]sudoloop         Odnawiaj sudo w tle, aby uniknąć wygaśnięcia"

#: src/help.rs:82
msgid "    --[no]chroot           Build packages in a chroot"
msgstr "    --[no]chroot           Buduj pakiety w chroot"

#: src/help.rs:83
msgid ""
"    --[no]failfast         Exit as soon as building an AUR package fails"
msgstr ""
"    --[no]failfast         Przerwij, gdy tylko budowanie pakietu z AUR się "
"nie powiedzie"

#: src/help.rs:84
msgid ""
"    --[no]keepsrc          Keep src/ and pkg/ dirs after building packages"
msgstr ""
"    --[no]keepsrc          Zachowaj katalogi src/ i pkg/ po zbudowaniu "
"pakietów"

#: src/help.rs:85
msgid "    --[no]sign             Sign packages with gpg"
msgstr "    --[no]sign             Podpisuj pakiety za pomocą gpg"

#: src/help.rs:86
msgid "    --[no]signdb           Sign databases with gpg"
msgstr "    --[no]signdb           Podpisuj bazy danych za pomocą gpg"

#: src/help.rs:87
msgid "    --[no]localrepo        Build packages into a local repo"
msgstr "    --[no]localrepo        Buduj pakiety do lokalnego repozytorium"

#: src/help.rs:88
msgid ""
"    --nocheck              Don't resolve checkdepends or run the check "
"function"
msgstr ""
"    --nocheck              Nie rozwiązuj checkdepends i nie uruchamiaj "
"funkcji check"

#: src/help.rs:90
msgid ""
"    --rootchrootpkgs       Packages to install in the root chroot (default: "
"base-devel)"
msgstr ""
"    --rootchrootpkgs       Pakiety do zainstalowania w głównym chroot "
"(domyślnie: base-devel)"

#: src/help.rs:92
msgid ""
"    --develsuffixes        Suffixes used to decide if a package is a devel "
"package"
msgstr ""
"    --develsuffixes        Przyrostki, po których pakiet uznaje się za devel"

#: src/help.rs:93
msgid "    --ignoredevel          Ignore devel upgrades for specified packages"
msgstr ""
"    --ignoredevel          Ignoruj aktualizacje devel dla podanych pakietów"

#: src/help.rs:94
msgid ""
"    --bottomup             Shows AUR's packages first and then repository's"
msgstr ""
"    --bottomup             Pokazuj najpierw pakiety z AUR, a potem z "
"repozytoriów"

#: src/help.rs:95
msgid ""
"    --topdown              Shows repository's packages first and then AUR's"
msgstr ""
"    --topdown              Pokazuj najpierw pakiety z repozytoriów, a potem "
"z AUR"

#: src/help.rs:97
msgid "show specific options:"
msgstr "opcje dla show:"

#: src/help.rs:98
msgid "    -c --complete         Used for completions"
