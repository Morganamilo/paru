#: src/help.rs:4
msgid "Usage:"
msgstr "Использование:"

#: src/help.rs:5
msgid "    paru"
msgstr "    paru"

#: src/help.rs:6
msgid "    paru <operation> [...]"
msgstr "    paru <действие> [...]"

#: src/help.rs:7
msgid "    paru <package(s)>"
msgstr "    paru <пакет(ы)>"

#: src/help.rs:9
msgid "Pacman operations:"
msgstr "Действия pacman:"

#: src/help.rs:10
msgid "    paru {-h --help}"
msgstr "    paru {-h --help}"

#: src/help.rs:11
msgid "    paru {-V --version}"
msgstr "    paru {-V --version}"

#: src/help.rs:12
msgid "    paru {-D --database}    <options> <package(s)>"
msgstr "    paru {-D --database}    <параметры> <пакет(ы)>"

#: src/help.rs:13
msgid "    paru {-F --files}       [options] [package(s)]"
msgstr "    paru {-F --files}       [параметры] [пакет(ы)]"

#: src/help.rs:14
msgid "    paru {-Q --query}       [options] [package(s)]"
msgstr "    paru {-Q --query}       [параметры] [пакет(ы)]"

#: src/help.rs:15
msgid "    paru {-R --remove}      [options] <package(s)>"
msgstr "    paru {-R --remove}      [параметры] <пакет(ы)>"

#: src/help.rs:16
msgid "    paru {-S --sync}        [options] [package(s)]"
msgstr "    paru {-S --sync}        [параметры] [пакет(ы)]"

#: src/help.rs:17
msgid "    paru {-T --deptest}     [options] [package(s)]"
msgstr "    paru {-T --deptest}     [параметры] [пакет(ы)]"

#: src/help.rs:18
msgid "    paru {-U --upgrade}     [options] [file(s)]"
msgstr "    paru {-U --upgrade}     [параметры] [файл(ы)]"

#: src/help.rs:20
msgid "New operations:"
msgstr "Новые действия:"

#: src/help.rs:21
msgid "    paru {-P --show}        [options]"
msgstr "    paru {-P --show}        [параметры]"

#: src/help.rs:22
msgid "    paru {-G --getpkgbuild} [package(s)]"
msgstr "    paru {-G --getpkgbuild} [пакет(ы)]"

#: src/help.rs:23
msgid "    paru {-B --build}       [dir(s)]"
msgstr "    paru {-B --build}       [каталог(и)]"

#: src/help.rs:25
msgid "If no arguments are provided 'paru -Syu' will be performed"
msgstr "Без аргументов выполняется 'paru -Syu'"

#: src/help.rs:27
msgid "Options without operation:"
msgstr "Параметры без действия:"

#: src/help.rs:28
msgid "    -c --clean            Remove unneeded dependencies"
msgstr "    -c --clean            Удалить ненужные зависимости"

#: src/help.rs:29
msgid ""
"       --gendb            Generates development package DB used for updating"
msgstr "       --gendb            Создать базу devel-пакетов для их обновления"

#: src/help.rs:31
msgid "New options:"
msgstr "Новые параметры:"

#: src/help.rs:32
msgid "       --repo              Assume targets are from the repositories"
msgstr "       --repo              Брать цели только из репозиториев"

#: src/help.rs:33
msgid ""
"       --pkgbuilds         Assume targets are from pkgbuild repositories"
msgstr "       --pkgbuilds         Брать цели только из репозиториев PKGBUILD"

#: src/help.rs:34
msgid "    -a --aur               Assume targets are from the AUR"
msgstr "    -a --aur               Брать цели только из AUR"

#: src/help.rs:35
msgid "    --mode      <mode>     Sets where paru looks for targets"
msgstr "    --mode      <режим>    Где paru ищет цели"

#: src/help.rs:37
msgid ""
"    --interactive          Enable interactive package selection for -S, -R, "
"-Ss and -Qs"
msgstr ""
"    --interactive          Выбирать пакеты из списка для -S, -R, -Ss и -Qs"

#: src/help.rs:39
msgid "    --aururl    <url>      Set an alternative AUR URL"
msgstr "    --aururl    <url>      Другой URL AUR"

#: src/help.rs:40
msgid ""
"    --aurrpcur  <url>      Set an alternative URL for the AUR /rpc endpoint"
msgstr "    --aurrpcur  <url>      Другой URL для /rpc в AUR"

#: src/help.rs:41
msgid "    --clonedir  <dir>      Directory used to download and run PKGBUILDs"
msgstr "    --clonedir  <каталог>  Каталог для загрузки и запуска PKGBUILD"

#: src/help.rs:43
msgid "    --makepkg   <file>     makepkg command to use"
msgstr "    --makepkg   <файл>     Какую команду makepkg использовать"

#: src/help.rs:44
msgid "    --mflags    <flags>    Pass arguments to makepkg"
msgstr "    --mflags    <флаги>    Передать аргументы makepkg"

#: src/help.rs:45
msgid "    --pacman    <file>     pacman command to use"
msgstr "    --pacman    <файл>     Какую команду pacman использовать"

#: src/help.rs:46
msgid "    --git       <file>     git command to use"
msgstr "    --git       <файл>     Какую команду git использовать"

#: src/help.rs:47
msgid "    --gitflags  <flags>    Pass arguments to git"
msgstr "    --gitflags  <флаги>    Передать аргументы git"

#: src/help.rs:48
msgid "    --sudo      <file>     sudo command to use"
msgstr "    --sudo      <файл>     Какую команду sudo использовать"

#: src/help.rs:49
msgid "    --sudoflags <flags>    Pass arguments to sudo"
msgstr "    --sudoflags <флаги>    Передать аргументы sudo"

#: src/help.rs:50
msgid "    --pkgctl    <file>     pkgctl command to use"
msgstr "    --pkgctl    <файл>     Какую команду pkgctl использовать"

#: src/help.rs:51
msgid "    --bat       <file>     bat command to use"
msgstr "    --bat       <файл>     Какую команду bat использовать"

#: src/help.rs:52
msgid "    --batflags  <flags>    Pass arguments to bat"
msgstr "    --batflags  <флаги>    Передать аргументы bat"

#: src/help.rs:53
msgid "    --gpg       <file>     gpg command to use"
msgstr "    --gpg       <файл>     Какую команду gpg использовать"

#: src/help.rs:54
msgid "    --gpgflags  <flags>    Pass arguments to gpg"
msgstr "    --gpgflags  <флаги>    Передать аргументы gpg"

#: src/help.rs:55
msgid "    --fm        <file>     File manager to use for PKGBUILD review"
msgstr "    --fm        <файл>     Файловый менеджер для просмотра PKGBUILD"

#: src/help.rs:56
msgid "    --fmflags   <flags>    Pass arguments to file manager"
msgstr "    --fmflags   <флаги>    Передать аргументы файловому менеджеру"

#: src/help.rs:58
msgid "    --completioninterval   <n> Time in days to refresh completion cache"
msgstr ""
"    --completioninterval   <n> Через сколько дней обновлять кэш "
"автодополнения"

#: src/help.rs:59
msgid ""
"    --sortby    <field>    Sort AUR results by a specific field during search"
msgstr ""
"    --sortby    <поле>     По какому полю сортировать результаты поиска в AUR"

#: src/help.rs:60
msgid "    --searchby  <field>    Search for packages using a specified field"
msgstr "    --searchby  <поле>     По какому полю искать пакеты"

#: src/help.rs:61
msgid ""
"    --limit     <limit>    Limits the number of items returned in a search"
msgstr "    --limit     <число>    Ограничить число результатов поиска"

#: src/help.rs:62
msgid "    -x --regex             Enable regex for aur search"
msgstr "    -x --regex             Искать в AUR по регулярному выражению"

#: src/help.rs:64
msgid "    --skipreview           Skip the review process"
msgstr "    --skipreview           Пропустить просмотр PKGBUILD"

#: src/help.rs:65
msgid "    --review               Don't skip the review process"
msgstr "    --review               Не пропускать просмотр PKGBUILD"

#: src/help.rs:66
msgid "    --[no]upgrademenu      Show interactive menu to skip upgrades"
msgstr "    --[no]upgrademenu      Показать меню для пропуска обновлений"

#: src/help.rs:67
msgid "    --[no]removemake       Remove makedepends after install"
msgstr "    --[no]removemake       Удалять зависимости сборки после установки"

#: src/help.rs:68
msgid "    --[no]cleanafter       Remove package sources after install"
msgstr "    --[no]cleanafter       Удалять исходники пакетов после установки"

#: src/help.rs:69
msgid "    --[no]rebuild          Always build target packages"
msgstr "    --[no]rebuild          Всегда собирать указанные пакеты"

#: src/help.rs:70
msgid "    --[no]redownload       Always download PKGBUILDs of targets"
msgstr "    --[no]redownload       Всегда загружать PKGBUILD указанных пакетов"

#: src/help.rs:72
msgid "    --[no]pgpfetch         Prompt to import PGP keys from PKGBUILDs"
msgstr "    --[no]pgpfetch         Предлагать импорт PGP-ключей из PKGBUILD"

#: src/help.rs:73
msgid ""
"    --[no]useask           Automatically resolve conflicts using pacman's "
"ask flag"
msgstr ""
"    --[no]useask           Разрешать конфликты автоматически через флаг ask "
"у pacman"

#: src/help.rs:74
msgid ""
"    --[no]savechanges      Commit changes to pkgbuilds made during review"
msgstr ""
"    --[no]savechanges      Коммитить правки PKGBUILD, сделанные при просмотре"

#: src/help.rs:75
msgid "    --[no]newsonupgrade    Print new news during sysupgrade"
msgstr ""
"    --[no]newsonupgrade    Показывать свежие новости при обновлении системы"

#: src/help.rs:76
msgid ""
"    --[no]combinedupgrade  Refresh then perform the repo and AUR upgrade "
"together"
msgstr ""
"    --[no]combinedupgrade  Обновить базы, затем пакеты репозиториев и AUR "
"вместе"

#: src/help.rs:77
msgid ""
"    --[no]batchinstall     Build multiple AUR packages then install them "
"together"
msgstr ""
"    --[no]batchinstall     Собрать несколько пакетов AUR и установить их "
"разом"

#: src/help.rs:78
msgid ""
"    --[no]provides         Look for matching providers when searching for "
"packages"
msgstr ""
"    --[no]provides         Искать подходящих поставщиков при поиске пакетов"

#: src/help.rs:79
msgid "    --[no]devel            Check development packages during sysupgrade"
msgstr ""
"    --[no]devel            Проверять devel-пакеты при обновлении системы"

#: src/help.rs:80
msgid ""
"    --[no]installdebug     Also install debug packages when a package "
"provides them"
msgstr "    --[no]installdebug     Ставить и отладочные пакеты, если они есть"

#: src/help.rs:81
msgid ""
"    --[no]sudoloop         Loop sudo calls in the background to avoid timeout"
msgstr ""
"    --[no]sudoloop         Продлевать sudo в фоне, чтобы не истёк тайм-аут"

#: src/help.rs:82
msgid "    --[no]chroot           Build packages in a chroot"
msgstr "    --[no]chroot           Собирать пакеты в chroot"

#: src/help.rs:83
msgid ""
"    --[no]failfast         Exit as soon as building an AUR package fails"
msgstr ""
"    --[no]failfast         Выходить при первой ошибке сборки пакета AUR"

#: src/help.rs:84
msgid ""
"    --[no]keepsrc          Keep src/ and pkg/ dirs after building packages"
msgstr "    --[no]keepsrc          Оставлять каталоги src/ и pkg/ после сборки"

#: src/help.rs:85
msgid "    --[no]sign             Sign packages with gpg"
msgstr "    --[no]sign             Подписывать пакеты с помощью gpg"

#: src/help.rs:86
msgid "    --[no]signdb           Sign databases with gpg"
msgstr "    --[no]signdb           Подписывать базы данных с помощью gpg"

#: src/help.rs:87
msgid "    --[no]localrepo        Build packages into a local repo"
msgstr "    --[no]localrepo        Собирать пакеты в локальный репозиторий"

#: src/help.rs:88
msgid ""
"    --nocheck              Don't resolve checkdepends or run the check "
"function"
msgstr ""
"    --nocheck              Не учитывать checkdepends и не запускать check()"

#: src/help.rs:90
msgid ""
"    --rootchrootpkgs       Packages to install in the root chroot (default: "
"base-devel)"
msgstr ""
"    --rootchrootpkgs       Пакеты для корневого chroot (по умолчанию: base-"
"devel)"

#: src/help.rs:92
